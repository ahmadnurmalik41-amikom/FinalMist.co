<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register - Fashion Store</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"/>

    <style>
        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
            font-family:'Poppins',sans-serif;
        }

        body{
            min-height:100vh;
            display:flex;
            justify-content:center;
            align-items:center;
            overflow:hidden;
            background:
            linear-gradient(rgba(0,0,0,.55),rgba(0,0,0,.7)),
            url('https://images.unsplash.com/photo-1445205170230-053b83016050?q=80&w=1974&auto=format&fit=crop');
            background-size:cover;
            background-position:center;
        }

        .bg-blur{
            position:absolute;
            width:500px;
            height:500px;
            background:linear-gradient(135deg,#ff00cc,#3333ff);
            border-radius:50%;
            filter:blur(150px);
            opacity:.35;
            animation:float 8s ease-in-out infinite;
        }

        .bg-blur.two{
            right:-100px;
            bottom:-100px;
            background:linear-gradient(135deg,#00ffe1,#005eff);
            animation-delay:3s;
        }

        @keyframes float{
            0%,100%{
                transform:translateY(0);
            }
            50%{
                transform:translateY(-30px);
            }
        }

        .register-box{
            position:relative;
            width:420px;
            padding:45px;
            border-radius:28px;
            background:rgba(255,255,255,0.08);
            backdrop-filter:blur(25px);
            border:1px solid rgba(255,255,255,0.15);
            box-shadow:0 8px 40px rgba(0,0,0,.4);
            color:white;
            z-index:2;
        }

        .brand{
            text-align:center;
            margin-bottom:25px;
        }

        .brand h1{
            font-size:34px;
            font-weight:700;
            letter-spacing:2px;
            margin-bottom:5px;
        }

        .brand p{
            color:#cfcfcf;
            font-size:14px;
        }

        .input-group-custom{
            position:relative;
            margin-bottom:22px;
        }

        .input-group-custom input{
            width:100%;
            height:55px;
            border:none;
            outline:none;
            border-radius:15px;
            background:rgba(255,255,255,0.08);
            padding:0 20px 0 50px;
            color:white;
            font-size:15px;
            transition:.3s;
        }

        .input-group-custom input:focus{
            background:rgba(255,255,255,0.14);
            border:1px solid #ffffff50;
            box-shadow:0 0 20px rgba(255,255,255,.15);
        }

        .input-group-custom i{
            position:absolute;
            left:18px;
            top:18px;
            color:#ddd;
            font-size:16px;
        }

        .input-group-custom input::placeholder{
            color:#ddd;
        }

        .register-btn{
            width:100%;
            height:55px;
            border:none;
            border-radius:16px;
            background:linear-gradient(135deg,#6a11cb,#2575fc);
            color:white;
            font-weight:600;
            font-size:16px;
            transition:.4s;
            margin-top:5px;
        }

        .register-btn:hover{
            transform:translateY(-3px);
            box-shadow:0 10px 25px rgba(37,117,252,.5);
        }

        .bottom-text{
            text-align:center;
            margin-top:22px;
            color:#dcdcdc;
            font-size:14px;
        }

        .bottom-text a{
            color:#fff;
            text-decoration:none;
            font-weight:600;
        }

        .bottom-text a:hover{
            color:#70a5ff;
        }

        .fashion-text{
            position:absolute;
            top:40px;
            left:50px;
            color:white;
            z-index:2;
        }

        .fashion-text h2{
            font-size:60px;
            font-weight:700;
            line-height:1.1;
        }

        .fashion-text span{
            color:#4ea3ff;
        }

        @media(max-width:992px){
            .fashion-text{
                display:none;
            }
        }

        @media(max-width:500px){
            .register-box{
                width:90%;
                padding:30px;
            }
        }
    </style>
</head>
<body>

    <div class="bg-blur"></div>
    <div class="bg-blur two"></div>

    <div class="fashion-text">
        <h2>Create Your <br> <span>Fashion</span> Account</h2>
    </div>

    <div class="register-box">

        <div class="brand">
            <h1>REGISTER</h1>
            <p>Create your premium fashion account</p>
        </div>

        <form action="/register" method="POST">

            <div class="input-group-custom">
                <i class="fa-solid fa-user"></i>
                <input type="text" name="name" placeholder="Full Name" required>
            </div>

            <div class="input-group-custom">
                <i class="fa-solid fa-envelope"></i>
                <input type="email" name="email" placeholder="Email Address" required>
            </div>

            <div class="input-group-custom">
                <i class="fa-solid fa-lock"></i>
                <input type="password" name="password" placeholder="Password" required>
            </div>

            <button type="submit" class="register-btn">
                Create Account
            </button>

        </form>

        <div class="bottom-text">
            Already have an account?
            <a href="/login">Login</a>
        </div>

    </div>

</body>
</html>