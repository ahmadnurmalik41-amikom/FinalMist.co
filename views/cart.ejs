<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Cart | Mist.Co</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Poppins',sans-serif;
}

body{
    background:#0f0f0f;
    color:white;
}

.cart-navbar{
    background:rgba(0,0,0,0.7);
    backdrop-filter:blur(12px);
    border-bottom:1px solid rgba(255,255,255,0.1);
}

.logo{
    font-size:28px;
    font-weight:700;
    color:white;
    text-decoration:none;
}

.cart-section{
    padding-top:120px;
    padding-bottom:80px;
}

.cart-title{
    font-size:48px;
    font-weight:700;
    margin-bottom:10px;
}

.cart-subtitle{
    color:#aaa;
    margin-bottom:50px;
}

.cart-card{
    background:#171717;
    border-radius:25px;
    overflow:hidden;
    border:1px solid rgba(255,255,255,0.05);
    transition:0.4s;
    height:100%;
}

.cart-card:hover{
    transform:translateY(-8px);
    border-color:white;
}

.cart-image{
    width:100%;
    height:300px;
    object-fit:cover;
}

.cart-content{
    padding:25px;
}

.product-name{
    font-size:22px;
    font-weight:600;
}

.product-price{
    font-size:20px;
    color:#ddd;
    margin-top:10px;
}

.remove-btn{
    border:none;
    background:#fff;
    color:black;
    padding:10px 20px;
    border-radius:50px;
    font-weight:600;
    margin-top:20px;
    transition:0.3s;
}

.remove-btn:hover{
    background:red;
    color:white;
}

.summary-box{
    background:linear-gradient(135deg,#1d1d1d,#101010);
    padding:40px;
    border-radius:30px;
    border:1px solid rgba(255,255,255,0.08);
    position:sticky;
    top:120px;
}

.summary-title{
    font-size:30px;
    font-weight:700;
    margin-bottom:30px;
}

.summary-item{
    display:flex;
    justify-content:space-between;
    margin-bottom:15px;
    color:#ccc;
}

.total-price{
    font-size:32px;
    font-weight:700;
}

.checkout-btn{
    width:100%;
    padding:16px;
    border:none;
    border-radius:60px;
    background:white;
    color:black;
    font-weight:700;
    margin-top:30px;
    transition:0.3s;
}

.checkout-btn:hover{
    transform:scale(1.03);
    background:#ddd;
}

.empty-cart{
    background:#171717;
    border-radius:25px;
    padding:80px 30px;
    text-align:center;
}

.empty-cart i{
    font-size:70px;
    margin-bottom:20px;
    color:#666;
}

.empty-cart h2{
    font-weight:700;
    margin-bottom:10px;
}

.empty-cart p{
    color:#888;
}

.shop-btn{
    display:inline-block;
    margin-top:30px;
    padding:14px 35px;
    border-radius:50px;
    background:white;
    color:black;
    text-decoration:none;
    font-weight:600;
}

.shop-btn:hover{
    background:#ddd;
}

@media(max-width:991px){

    .summary-box{
        margin-top:40px;
        position:relative;
        top:0;
    }

    .cart-title{
        font-size:36px;
    }

}

</style>

</head>
<body>

<!-- NAVBAR -->

<nav class="navbar navbar-dark fixed-top cart-navbar">
    <div class="container">

        <a href="/" class="logo">
            Mist.Co
        </a>

        <a href="/" class="btn btn-outline-light rounded-pill px-4">
            Back
        </a>

    </div>
</nav>

<!-- CART -->

<section class="cart-section">

<div class="container">

    <h1 class="cart-title">
        Shopping Cart
    </h1>

    <p class="cart-subtitle">
        Premium selected items in your bag.
    </p>

    <% if(cart.length === 0){ %>

        <div class="empty-cart">

            <i class="bi bi-bag-x"></i>

            <h2>Your cart is empty</h2>

            <p>
                Looks like you haven't added anything yet.
            </p>

            <a href="/" class="shop-btn">
                Continue Shopping
            </a>

        </div>

    <% } else { %>

    <div class="row">

        <div class="col-lg-8">

            <div class="row">

                <% let total = 0; %>

                <% cart.forEach(item => { %>

                <% total += item.price; %>

                <div class="col-md-6 mb-4">

                    <div class="cart-card">

                        <img src="<%= item.image %>" class="cart-image">

                        <div class="cart-content">

                            <h3 class="product-name">
                                <%= item.name %>
                            </h3>

                            <p class="product-price">
                                Rp <%= item.price.toLocaleString() %>
                            </p>

                            <button class="remove-btn">
                                Remove
                            </button>

                        </div>

                    </div>

                </div>

                <% }) %>

            </div>

        </div>

        <div class="col-lg-4">

            <div class="summary-box">

                <h2 class="summary-title">
                    Order Summary
                </h2>

                <div class="summary-item">
                    <span>Items</span>
                    <span><%= cart.length %></span>
                </div>

                <div class="summary-item">
                    <span>Shipping</span>
                    <span>Free</span>
                </div>

                <hr class="border-secondary">

                <div class="d-flex justify-content-between align-items-center mt-4">

                    <span>Total</span>

                    <span class="total-price">
                        Rp <%= total.toLocaleString() %>
                    </span>

                </div>

                <button class="checkout-btn">
                    Checkout
                </button>

            </div>

        </div>

    </div>

    <% } %>

</div>

</section>

</body>
</html>